# /etc/tv-agent.toml
# The install script copies this file once. Fill the empty values on the Pi.
# Do not commit the filled file. Tokens come from `pnpm gen:secrets`.

server_url = "https://tv-dashboard-sigma-one.vercel.app"
pi_token = ""
tv_token = ""

# Friendly name from the Google Home app. IP is the fallback when mDNS is blocked.
chromecast_name = ""
chromecast_ip = ""

loop_seconds = 15
idle_seconds = 60
heartbeat_seconds = 60
backoff_cap_seconds = 300
discovery_timeout_seconds = 5

# DashCast hard rules (pychromecast DashCastController + AlexxIT/DashCast):
# - force=true disables reload_seconds AND relaunches the DashCast app on every later
#   load_url() → the splash flash. Prefer force=false; /tv allows iframe embedding.
# - Never load_url for view rotation or keepalive. Rotate in-page via /api/state.
# - reload_seconds (force=false only) soft-reloads the page for freeze/idle recovery.
#   1800 = 30 min. 300–540 is fine if Cast idle-timeouts are aggressive.
# - dashboard_refresh_seconds re-casts the same URL from the Pi — only for force=true
#   (no receiver reload). Leave 0 when force=false. Never use periodic force-recast.
dashcast_force = false
dashcast_reload_seconds = 1800
dashboard_refresh_seconds = 0
