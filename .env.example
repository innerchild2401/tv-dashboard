# Copy to .env.local for this machine. The same names go in the Vercel
# project settings for Production and Preview. Leave values empty until you
# have them. Do not invent secrets and do not commit .env.local.
#
# Token values come from `pnpm gen:secrets`. The PIN is chosen by you.

# Supabase → Project Settings → API. Used only for the realtime nudge.
# The anon key has no table access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API. Server only. Never expose it as NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Database password kept for `supabase link`. Local only, not a Vercel runtime variable.
SUPABASE_DB_PASSWORD=

# Bearer tokens. Generate with `pnpm gen:secrets`.
TV_TOKEN=
AGENT_TOKEN=
PI_TOKEN=

# 4 to 6 digits, chosen by you. Not generated.
REMOTE_PIN=

# Session signing. Generate with `pnpm gen:secrets`.
SESSION_SECRET=

# One secret iCal address per person, from Google Calendar settings.
# The suffix matches the person id, uppercased.
ICAL_URL_ALEX=
ICAL_URL_MARA=

# TikTok metrics, from the Zernio dashboard.
ZERNIO_API_KEY=

# Analytics provider is not chosen yet. Add that provider's keys when it is.
# ANALYTICS_PROVIDER=
