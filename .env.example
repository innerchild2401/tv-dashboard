# Copy to .env.local for this machine. The same names go in the Vercel
# project settings for Production and Preview. Leave values empty until you
# have them. Do not invent secrets and do not commit .env.local.
#
# Token values come from `pnpm gen:secrets`. The PIN is chosen by you.

# Supabase → Project Settings → API. Used only for the realtime nudge.
# The anon key has no table access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API. Server only. Never expose it as NEXT_PUBLIC_.
# `pnpm backup` and `pnpm restore` read this and the URL above. They write
# household data under backups/, which is gitignored. Do not commit that folder.
SUPABASE_SERVICE_ROLE_KEY=

# Database password kept for `supabase link`. Local only, not a Vercel runtime variable.
SUPABASE_DB_PASSWORD=

# Bearer tokens. Generate with `pnpm gen:secrets`.
# TV_TOKEN is also pasted into /etc/tv-agent.toml on the Pi. The Pi adds it to the cast URL.
TV_TOKEN=
AGENT_TOKEN=
# Same value as pi_token in /etc/tv-agent.toml.
PI_TOKEN=

# 4 to 6 digits, chosen by you. Not generated.
REMOTE_PIN=

# Session signing. Generate with `pnpm gen:secrets`.
SESSION_SECRET=

# Secret iCal address for Alex, from Google Calendar settings.
# The suffix matches the person id, uppercased. Leave empty until you have it.
# Weather uses Open-Meteo and needs no key. The place comes from Config.
ICAL_URL_ALEX=

# TikTok metrics, from the Zernio dashboard. Leave the key empty until you have one.
# The account id is optional. Follower stats can be read without it.
# Docs: https://docs.zernio.com/platforms/tiktok/analytics
ZERNIO_API_KEY=
ZERNIO_ACCOUNT_ID=
# ZERNIO_API_URL=https://api.zernio.com

# Analytics provider is not chosen yet. Leave ANALYTICS_PROVIDER empty.
# When you pick one, set it to plausible, umami, or ga4 and fill only that block.
ANALYTICS_PROVIDER=
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=
# PLAUSIBLE_API_URL=https://plausible.io
UMAMI_API_URL=
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
